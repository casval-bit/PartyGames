# Copie ce fichier en .env et remplis les deux valeurs (Supabase > Project Settings > API).
# Sans ces valeurs, l'appli tourne en "mode local" (test sur un seul appareil, avec bots).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Facultatif, sur ton ordinateur seulement (jamais dans le dépôt) : comptes testeurs, séparés par des virgules.
# Connecté avec une de ces adresses, Trône des Mondes > Paramètres montre des boutons pour ajouter des Éclats et des boosters.
VITE_TESTEURS=
